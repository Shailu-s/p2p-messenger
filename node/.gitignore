# private identity keys — never commit
# *.key      = libp2p Ed25519 host key (signing)
# *.x25519   = long-term X25519 key (ratchet DH); whoever holds it can
#              impersonate this node, so it must never leave the machine
*.key
*.x25519

# compiled binary
p2pchat

# runtime peer state (contains local LAN addresses)
peers-*.json
